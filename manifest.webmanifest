{
  "name": "BIT-Nova PDF — PDF-Editor",
  "short_name": "BIT-Nova PDF",
  "description": "Vollständig lokaler PDF-Editor: ansehen, kommentieren, organisieren, signieren, bearbeiten. Läuft offline.",
  "start_url": "renderer/index.html",
  "scope": ".",
  "id": "novapdf",
  "display": "standalone",
  "background_color": "#0f1320",
  "theme_color": "#0f1320",
  "orientation": "any",
  "lang": "de",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "renderer/index.html", "accept": { "application/pdf": [".pdf"] } }
  ]
}
