{
  "name": "bit-nova-pdf",
  "version": "1.1.4",
  "description": "BIT-Nova PDF — portable PDF editor (view, annotate, organize, forms, sign, edit)",
  "author": "Schwarz Architekturbüro",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "copy-vendor": "node scripts/copy-vendor.js",
    "make-icons": "electron scripts/make-icons.js",
    "postinstall": "node scripts/copy-vendor.js",
    "dist": "node scripts/copy-vendor.js && electron-builder --win portable --publish never",
    "dist:mac": "node scripts/copy-vendor.js && electron-builder --mac dmg --publish never",
    "dist:all": "node scripts/copy-vendor.js && electron-builder -mw --publish never"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.9.1",
    "@phosphor-icons/web": "^2.1.2",
    "pdfjs-dist": "^6.2.108",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@pdf-lib/upng": "^1.0.1",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "de.schwarzarchitektur.novapdf",
    "productName": "BIT-Nova PDF",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "vendor/**/*",
      "manifest.webmanifest",
      "sw.js",
      "icons/**/*",
      "!vendor/tessdata",
      "!vendor/tesseract"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF-Dokument",
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/tessdata",
        "to": "tessdata"
      }
    ],
    "win": {
      "icon": "icons/icon-512.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "BIT-Nova-PDF-portable.exe"
    },
    "mac": {
      "icon": "icons/icon-512.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "PDF-Dokument",
            "CFBundleTypeRole": "Viewer",
            "CFBundleTypeExtensions": [
              "pdf"
            ],
            "LSItemContentTypes": [
              "com.adobe.pdf"
            ],
            "LSHandlerRank": "Alternate"
          }
        ]
      }
    },
    "dmg": {
      "artifactName": "BIT-Nova-PDF-${arch}.dmg"
    }
  }
}
