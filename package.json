{
  "name": "nova-pdf",
  "version": "1.0.0",
  "description": "NovaPDF — portable PDF editor (view, annotate, organize, forms, sign, edit)",
  "author": "Schwarz Architekturbüro",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "copy-vendor": "node scripts/copy-vendor.js",
    "postinstall": "node scripts/copy-vendor.js",
    "dist": "node scripts/copy-vendor.js && electron-builder --win portable",
    "dist:mac": "node scripts/copy-vendor.js && electron-builder --mac dmg",
    "dist:all": "node scripts/copy-vendor.js && electron-builder -mw"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.7.1",
    "@phosphor-icons/web": "^2.1.2",
    "pdfjs-dist": "^4.7.76",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.schwarzarchitektur.novapdf",
    "productName": "NovaPDF",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "vendor/**/*",
      "manifest.webmanifest",
      "sw.js",
      "icons/**/*",
      "!vendor/tessdata",
      "!vendor/tesseract"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF-Dokument",
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/tessdata",
        "to": "tessdata"
      }
    ],
    "win": {
      "icon": "icons/icon-512.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "NovaPDF-${version}-portable.exe"
    },
    "mac": {
      "icon": "icons/icon-512.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "PDF-Dokument",
            "CFBundleTypeRole": "Viewer",
            "CFBundleTypeExtensions": ["pdf"],
            "LSItemContentTypes": ["com.adobe.pdf"],
            "LSHandlerRank": "Alternate"
          }
        ]
      }
    },
    "dmg": {
      "artifactName": "NovaPDF-${version}-${arch}.dmg"
    }
  }
}
